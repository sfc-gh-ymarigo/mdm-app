# Copy to .env.local (gitignored) and fill in. Read by start-dev.sh.
# Postgres passwords are NOT set here: put them in ~/.pgpass (host:port:*:user:password).

# Snowflake Postgres instance host (SHOW POSTGRES INSTANCES)
PG_HOST=
# PG_USER=snowflake_admin   # admin pool (system jobs)
# PG_APP_USER=mdm_app       # user pool (Postgres RLS enforced)

# Snowflake account and object names. Mirror DB, mirror name, PG instance, agent and
# semantic view derive from MDM_DATABASE unless set explicitly (MDM_MIRROR_DATABASE, ...).
SNOWFLAKE_ACCOUNT=
MDM_DATABASE=MDM
MDM_WAREHOUSE=MDM_WH
# MDM_ANALYTICS_SCHEMA=MDM_ANALYTICS
# MDM_SF_OPS_ROLE=           # role for mirror / dynamic-table admin calls (default: service role)
# MDM_VIEWER_SF_ROLE=MDM_VIEWER_ROLE

# Snowflake auth for the API (first match wins; in SPCS the OAuth token is used automatically)
SF_USER=
SF_PRIVATE_KEY_PATH=
# SF_PRIVATE_KEY_PASSPHRASE=
# SF_PAT=
# SF_PASSWORD= + SF_ALLOW_PASSWORD=1   # discouraged: repeated failures lock the user

# Identity: 1 = trust the x-mdm-user header (local user switcher). Never in SPCS.
MDM_DEV_AUTH=1
